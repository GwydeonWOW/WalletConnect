# ===========================================
# Wallet Connect - Production Environment
# ===========================================
# Copy this file and fill in the values for Coolify deployment.

# Required secrets (CHANGE THESE)
POSTGRES_PASSWORD=your-secure-password-here
REDIS_PASSWORD=your-secure-redis-password-here
SESSION_SECRET=your-64-char-random-session-secret

# Database
POSTGRES_USER=postgres
POSTGRES_DB=walletconnect

# WebAuthn / Passkeys
WEBAUTHN_RP_NAME=Wallet Connect
WEBAUTHN_RP_ID=your-domain.com
WEBAUTHN_ORIGIN=https://your-domain.com

# Frontend
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api
WEB_PORT=3000

# External APIs (optional but recommended)
COINGECKO_API_KEY=
ZERION_API_KEY=

# RPCs (defaults are public free tier)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
ZERION_BASE_URL=https://api.zerion.io/v1

# Docker image tag
TAG=latest
