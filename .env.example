# Environment
NODE_ENV=development

# Server
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/walletconnect

# Redis
REDIS_URL=redis://localhost:6379

# CoinGecko (free tier - no key needed, but add one for higher limits)
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Zerion (requires API key from zerion.io)
ZERION_API_KEY=
ZERION_BASE_URL=https://api.zerion.io/v1

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Sui
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# WebAuthn / Passkeys
WEBAUTHN_RP_NAME=Wallet Connect
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Session
SESSION_SECRET=change-me-in-production-use-a-random-64-char-string

# Frontend
FRONTEND_URL=http://localhost:3000
