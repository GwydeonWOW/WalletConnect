{
  "name": "wallet-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Crypto portfolio aggregation web app - read only",
  "scripts": {
    "dev": "pnpm --filter ./apps/* dev",
    "dev:api": "pnpm --filter @wallet-connect/api dev",
    "dev:web": "pnpm --filter @wallet-connect/web dev",
    "dev:worker": "pnpm --filter @wallet-connect/worker dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @wallet-connect/api db:migrate",
    "db:generate": "pnpm --filter @wallet-connect/api db:generate",
    "db:seed": "pnpm --filter @wallet-connect/api db:seed",
    "db:reset": "pnpm --filter @wallet-connect/api db:reset"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "protobufjs",
      "keccak",
      "tiny-secp256k1",
      "bufferutil",
      "utf-8-validate",
      "msgpackr-extract",
      "blake-hash",
      "@stellar/stellar-sdk",
      "usb",
      "@simplewebauthn/types"
    ]
  }
}
